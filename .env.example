PAYLOAD_SECRET=mygeneratedsecret
DATABASE_URI=mongodb://127.0.0.1/template-ecommerce

COMPANY_NAME="NABEA e.U."
TWITTER_CREATOR=
TWITTER_SITE=
SITE_NAME="Nabea"
NEXT_PUBLIC_SITE_NAME="Nabea"

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Production (canonical www — apex redirects to www):
# NEXT_PUBLIC_SERVER_URL=https://www.nabea.at
# PAYLOAD_PUBLIC_SERVER_URL=https://www.nabea.at

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# Stripe API keys
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_

# Resend (inquiry + stock notification emails). From address must use your verified domain.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=contact@nabea.at
RESEND_FROM_NAME=Nabea
RESEND_NEWSLETTER_TOPIC_ID=
# Shop inbox for stock-notification alerts (defaults to RESEND_FROM_ADDRESS)
STOCK_NOTIFICATION_TO=contact@nabea.at
# Shop inbox for new-order alerts (defaults to STOCK_NOTIFICATION_TO, then RESEND_FROM_ADDRESS)
ORDER_NOTIFICATION_TO=contact@nabea.at

# Austrian Rechnung (invoice PDF). Public UID for NABEA e.U.
INVOICE_SELLER_UID=ATU83282528
# VAT rate used to reverse-calc contained MwSt from brutto order totals (default 0.20 = 20%)
INVOICE_VAT_RATE=0.20

# Google Analytics 4 (storefront only — loads after cookie consent)
# Production: set on Vercel, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Cloudflare R2 (Payload media via @payloadcms/storage-s3 — not storage-r2)
# Real values go in `.env` and Vercel — never commit secrets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nabea-media
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=
# Keep until Blob→R2 copy is finished
BLOB_READ_WRITE_TOKEN=
